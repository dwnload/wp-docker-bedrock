{
  "name": "dwnload/wp-docker-bedrock",
  "type": "project",
  "license": "MIT",
  "repositories": [
    {
      "name": "wp-composer",
      "type": "composer",
      "url": "https://repo.wp-composer.com",
      "only": [
        "wp-plugin/*",
        "wp-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.5",
    "composer/installers": "^2.3",
    "oscarotero/env": "^2.1",
    "roots/bedrock-autoloader": "^1.1",
    "roots/bedrock-disallow-indexing": "^2.1",
    "roots/wordpress": "^7.1",
    "roots/wp-config": "^1.0 || ^2.0",
    "wp-theme/twentytwentyfive": "^1.0",
    "vlucas/phpdotenv": "^5.7"
  },
  "require-dev": {},
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {}
}
